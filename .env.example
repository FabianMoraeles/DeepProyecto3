# Copia a .env. Nunca publiques una clave real.
ANTHROPIC_API_KEY=
DATOCLARO_PROVIDER=anthropic
DATOCLARO_MODEL=claude-haiku-5-5
# lexical funciona sin descargar modelos. semantic usa requirements-semantic.txt.
DATOCLARO_RETRIEVAL=lexical
OLLAMA_HOST=http://127.0.0.1:11434
# Tarifas USD por millón de tokens: configura las vigentes para cada modelo.
DATOCLARO_PRICES_JSON={}
